# Copy this file to .env and fill in your own key -- .env is gitignored
# and never committed. Get a free key at https://finnhub.io (free tier:
# 60 requests/minute, includes the company-news endpoint).
FINNHUB_API_KEY=

# --- LLM provider (app/core/llm_provider.py) ---------------------------

# "hosted" (default, unset also means hosted) calls any OpenAI-compatible
# chat completions API (Groq, Together, OpenRouter, OpenAI, ...) -- requires
# the three vars below to be filled in, or get_llm_provider() raises at
# construction. See scripts/compare_local_vs_hosted_narrative.py's own
# docstring before ever using "hosted" for anything real: the prompts in
# this codebase are raw text-continuation, not chat-formatted, and a
# hosted chat model may answer them differently than the local model
# continues them. That script is the required manual check for this,
# not this file.
# "local" runs Qwen2.5-1.5B-Instruct on-box via llama.cpp instead -- no
# external account, no cost, no rate limit, and it's what the three
# LLM_* vars below do nothing for. Fully supported, just no longer the
# default.
LLM_PROVIDER=hosted

# Only read when LLM_PROVIDER=hosted (the default). Provider's
# OpenAI-compatible base URL (no trailing /chat/completions -- that's
# appended automatically), e.g. https://api.groq.com/openai/v1 or
# https://api.openai.com/v1.
LLM_BASE_URL=
# If using Groq: free-tier keys expire periodically -- the one this
# deployment was last configured with expires ~2026-10-27. Rotate it
# at https://console.groq.com/keys before then, or hosted narrative/
# planning calls start failing with a 401 (surfaced as the structured
# LLM_PROVIDER_ERROR job error code, not a silent failure -- see
# app/api/jobs.py -- but still worth not hitting in production).
LLM_API_KEY=
LLM_MODEL=

# Background job worker count (app/api/jobs.py). Ignored entirely when
# LLM_PROVIDER=local -- hard-pinned to 1 in code regardless of this
# value, since llama.cpp's shared context isn't documented as safe for
# concurrent generate() calls. Defaults to 1 even when LLM_PROVIDER=hosted:
# removing the LLM as a concurrency blocker doesn't mean the rest of the
# pipeline (SEC EDGAR's rate limit, Finnhub/News free-tier caps, the
# shared FinBERT model, the shared ChromaDB client, the narrative cache's
# check-then-set path) has been audited for concurrent access -- raising
# this is a deliberate opt-in after that audit, not a default.
MAX_CONCURRENT_JOBS=1

# --- Deployment (Railway -- see README.md "Deploying to Railway") ------

# Base directory for everything that must survive a redeploy: jobs.db
# (app/api/db.py), rendered PDFs (app/api/jobs.py's REPORTS_DIR), and
# LLM call logs (LOG_LLM_CALLS below) -- see app/core/paths.py. Unset
# (the default) uses the repo root, which is correct for local dev but
# WRONG in any container deployment: container filesystems are wiped
# on every redeploy, silently discarding every job record, PDF, and
# log written there. In production, point this at a mounted persistent
# volume's path, e.g. Railway: /data.
DATA_DIR=

# Comma-separated browser origins allowed to call this API cross-origin,
# e.g. https://app.example.com,https://staging.example.com. Empty/unset
# (the default) allows none -- safe by default since this API has no
# browser client yet; server-to-server/curl calls are unaffected either
# way (CORS is a browser-enforced restriction, not a server-side one).
ALLOWED_ORIGINS=

# Shared secret required in the X-API-Key header on every /v1/* request
# (/health stays open) -- see app/api/main.py's require_api_key
# middleware for why this is explicitly NOT real authentication, just
# quota protection for a public URL. Empty/unset (the default) disables
# the check entirely (existing local-dev/test behavior) -- MUST be set
# to a real random value before this is deployed anywhere public, or
# anyone with the URL can spend this deployment's real Finnhub/Groq
# quota. Generate one with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
API_KEY=

# Logs every real LLM call (timestamp, provider, model, full prompt,
# full response, token usage, latency) as JSONL under DATA_DIR/llm_logs/
# -- training-data collection for a future distillation pass, not a
# debug toggle. Defaults ON; set to "false" to disable. See
# app/core/llm_provider.py's _log_llm_call.
LOG_LLM_CALLS=true
