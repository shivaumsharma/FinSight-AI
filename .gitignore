__pycache__/
*.pyc

.venv/
venv/
env/

.cache/
.chroma/

.streamlit/

*.db

models/

# Disk cache for SEC EDGAR fetches (ticker->CIK map + fetched filings) --
# regenerated on demand, not source.
filings_cache/

# ChromaDB persistent store (embeddings + HNSW index binaries) -- fully
# regenerated on demand by RAGPipeline.ingest_company_disclosure() from
# live SEC filings, not source. Was previously tracked in git (~8MB of
# binary index files that changed on every local run of the app).
vector_db/

# Saved fine-tuned embedding model weights (419MB, exceeds GitHub's
# 100MB per-file limit -- would need Git LFS to commit at all). Not
# used in production: scripts/evaluate_embedding_finetune.py measured
# this fine-tune as WORSE than the baseline BGE model on the held-out
# retrieval eval set, so it was never deployed. Reproducible from
# scripts/embedding_training_pairs.jsonl + scripts/finetune_embeddings.py
# if ever needed again.
scripts/finetuned_bge_embeddings/

# Rendered PDFs from app/api/jobs.py -- regenerated per job, referenced
# from jobs.db (also gitignored via *.db above) by path, not committed.
# Anchored to the repo root (leading /) -- a bare "reports/" would also
# match web/src/app/api/reports/ (the Recent Reports proxy route,
# real source code), since unanchored gitignore patterns match at any
# depth.
/reports/

# Every real LLM prompt/response pair this deployment sees (app/core/
# llm_provider.py, LOG_LLM_CALLS) -- training-data collection for a
# future distillation pass, not source, and can contain retrieved SEC
# filing text/real user questions that shouldn't be committed.
llm_logs/

# Output of scripts/compare_local_vs_hosted_narrative.py -- a local,
# point-in-time comparison artifact for a manual review, not source.
narrative_comparison/

# Debug logs and point-in-time backtest result dumps -- regenerated by
# running the scripts, not source.
logs/
scripts/backtest_results_*.json

.idea/
.vscode/
.claude/

# Local secrets (Finnhub API key, etc.) -- never commit real values.
# Copy .env.example to .env and fill in your own key.
.env
# Next.js frontend (web/) -- has its own .gitignore for build artifacts;
# this repo-root .gitignore only needs to keep node_modules/ out.
web/node_modules/
